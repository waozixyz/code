@@ -0,0 +1,35 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// Telemetry is removed from this build. Built-in extensions bundle this module in place of
+// `@vscode/extension-telemetry`, so their reporters exist but nothing is collected or sent.
+
+type TelemetryLevel = 'all' | 'error' | 'crash' | 'off';
+
+interface Disposable {
+	dispose(): void;
+}
+
+function noEvent(_listener: unknown, _thisArgs?: unknown, disposables?: Disposable[]): Disposable {
+	const disposable = { dispose() { } };
+	disposables?.push(disposable);
+	return disposable;
+}
+
+export class TelemetryReporter {
+	readonly telemetryLevel: TelemetryLevel = 'off';
+	readonly onDidChangeTelemetryLevel = noEvent;
+
+	constructor(_connectionString?: string, _replacementOptions?: unknown[]) { }
+
+	sendTelemetryEvent(): void { }
+	sendRawTelemetryEvent(): void { }
+	sendDangerousTelemetryEvent(): void { }
+	sendTelemetryErrorEvent(): void { }
+	sendDangerousTelemetryErrorEvent(): void { }
+	async dispose(): Promise<void> { }
+}
+
+export default TelemetryReporter;
