@@ -0,0 +1,33 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// Experiments are removed from this build. Built-in extensions bundle this module in place of
+// `vscode-tas-client`, so no assignments are fetched and every flight and treatment is unset.
+
+export enum TargetPopulation {
+	Team = 'team',
+	Internal = 'internal',
+	Insiders = 'insider',
+	Public = 'public',
+}
+
+class RemovedExperimentationService {
+	readonly initializePromise = Promise.resolve();
+	readonly initialFetch = Promise.resolve();
+
+	isFlightEnabled(_flight: string): boolean { return false; }
+	isCachedFlightEnabled(_flight: string): Promise<boolean> { return Promise.resolve(false); }
+	isFlightEnabledAsync(_flight: string): Promise<boolean> { return Promise.resolve(false); }
+	getTreatmentVariable<T>(_configId: string, _name: string): T | undefined { return undefined; }
+	getTreatmentVariableAsync<T>(_configId: string, _name: string): Promise<T | undefined> { return Promise.resolve(undefined); }
+}
+
+export function getExperimentationService(..._args: unknown[]): RemovedExperimentationService {
+	return new RemovedExperimentationService();
+}
+
+export async function getExperimentationServiceAsync(..._args: unknown[]): Promise<RemovedExperimentationService> {
+	return new RemovedExperimentationService();
+}
